<?xml version="1.0" encoding="utf-8"?>
<!-- Today's page from two cells wide: the date and how far the page has got, beside the miniature
     (as in widget_today_small). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/today"
            android:textColor="@color/widget_accent"
            android:textSize="12sp" />

        <!-- The date in Fraunces, as in the app: drawn by the app, since a widget's text cannot
             use a bundled font. -->
        <ImageView
            android:id="@+id/widget_numeral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:tint="@color/widget_ink" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_page"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_sheet">

        <ImageView
            android:id="@+id/widget_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_grid" />

        <ImageView
            android:id="@+id/widget_printed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_ink" />

        <ImageView
            android:id="@+id/widget_pen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_pen" />
    </FrameLayout>
</LinearLayout>
