<?xml version="1.0" encoding="utf-8"?>
<!-- Today's page at the smallest size: the miniature alone. The miniature is three alpha masks
     (grid, printed digits, the player's ink), each tinted with a day/night colour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/widget_page"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_sheet">

        <ImageView
            android:id="@+id/widget_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_grid" />

        <ImageView
            android:id="@+id/widget_printed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_ink" />

        <ImageView
            android:id="@+id/widget_pen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/widget_pen" />
    </FrameLayout>
</FrameLayout>
